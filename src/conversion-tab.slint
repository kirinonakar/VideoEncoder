import { AppLanguage, JobStatus, LocalizedText, LanguageComboBox } from "language.slint";
import { Button, CheckBox, LineEdit, ProgressIndicator, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { QueueSource } from "file-name.slint";

export struct ConversionItem {
    id: int,
    path: string,
    source-info: LocalizedText,
    status: JobStatus,
    detail: LocalizedText,
}

export component ConversionTab inherits VerticalLayout {
    in property <[ConversionItem]> jobs;
    in-out property <string> output-folder;
    in property <bool> busy;
    in property <bool> other-job-running;
    in property <float> progress;
    in property <LocalizedText> status;
    in property <LocalizedText> detail;
    in-out property <int> mode-index;
    in-out property <int> format-index;
    in-out property <int> image-format;
    in-out property <bool> image-lossless;
    in-out property <float> image-quality;
    in-out property <int> image-compression;
    in-out property <string> resize-width;
    in-out property <string> resize-height;
    in-out property <string> suffix;
    private property <bool> image-mode: mode-index == 1;
    private property <bool> can-toggle-lossless: image-format >= 5;
    private property <bool> can-set-quality: image-format == 1 || (can-toggle-lossless && !image-lossless);
    private property <bool> can-set-compression: image-format == 0 || image-format == 3 || can-toggle-lossless;
    callback pick-files();
    callback pick-folder();
    callback select-output-folder();
    callback remove-job(int);
    callback move-job(int, int);
    callback remove-completed-jobs();
    callback clear-list();
    callback show-result(int);
    callback start();
    callback retry();
    callback cancel();

    padding: 10px;
    spacing: 12px;

    Rectangle {
        vertical-stretch: 0;
        background: AppTheme.surface;
        border-color: AppTheme.border;
        border-width: 1px;
        border-radius: 12px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppLanguage.tr("Mode", "변환 모드"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                LanguageComboBox {
                    width: 150px;
                    english: ["Animation", "Image"];
                    korean: ["애니메이션", "이미지"];
                    current-index <=> root.mode-index;
                    enabled: !root.busy;
                }
                Text { text: AppLanguage.tr("Format", "출력 형식"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                if !root.image-mode : LanguageComboBox {
                    width: 200px;
                    english: ["Animated GIF", "Animated WebP", "Animated AVIF", "Animated JPEG XL"];
                    korean: ["애니메이션 GIF", "애니메이션 WebP", "애니메이션 AVIF", "애니메이션 JPEG XL"];
                    current-index <=> root.format-index;
                    enabled: !root.busy;
                }
                if root.image-mode : LanguageComboBox {
                    width: 200px;
                    english: ["PNG", "JPEG", "BMP", "TIFF", "GIF", "WebP", "AVIF", "JPEG XL (JXL)"];
                    korean: self.english;
                    current-index <=> root.image-format;
                    enabled: !root.busy;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if root.image-mode && (root.can-set-quality || root.can-set-compression) : HorizontalLayout {
                spacing: 10px;
                Text { text: AppLanguage.tr("Compression", "압축 설정"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                if root.can-toggle-lossless : CheckBox {
                    text: AppLanguage.tr("Lossless", "무손실");
                    checked <=> root.image-lossless;
                    enabled: !root.busy;
                }
                if root.can-set-quality : HorizontalLayout {
                    spacing: 6px;
                    Text { text: AppLanguage.tr("Quality", "품질"); color: AppTheme.text; vertical-alignment: center; }
                    Slider {
                        accessible-label: AppLanguage.tr("Image quality", "이미지 품질");
                        width: 110px;
                        minimum: 1;
                        maximum: 100;
                        step: 1;
                        value <=> root.image-quality;
                        enabled: !root.busy;
                    }
                    Text {
                        width: 28px;
                        text: round(root.image-quality);
                        color: AppTheme.text;
                        vertical-alignment: center;
                    }
                }
                if root.can-set-compression : LanguageComboBox {
                    width: 154px;
                    english: ["Fast", "Balanced", "High compression"];
                    korean: ["빠르게", "균형", "높은 압축"];
                    current-index <=> root.image-compression;
                    enabled: !root.busy;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppLanguage.tr("Size", "출력 크기"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                LineEdit {
                    width: 100px;
                    text <=> root.resize-width;
                    placeholder-text: AppLanguage.tr("Width (px)", "가로 (px)");
                    input-type: number;
                    enabled: !root.busy;
                }
                Text { text: "×"; color: AppTheme.muted; vertical-alignment: center; }
                LineEdit {
                    width: 100px;
                    text <=> root.resize-height;
                    placeholder-text: AppLanguage.tr("Height (px)", "세로 (px)");
                    input-type: number;
                    enabled: !root.busy;
                }
                Text {
                    horizontal-stretch: 1;
                    text: AppLanguage.tr("Enter one dimension to keep the aspect ratio. Leave both blank for original size.", "한쪽만 입력하면 비율 유지 · 모두 비우면 원본 크기");
                    color: AppTheme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppLanguage.tr("Output suffix", "출력 접미사"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                LineEdit {
                    width: 200px;
                    text <=> root.suffix;
                    placeholder-text: AppLanguage.tr("Optional", "선택 사항");
                    enabled: !root.busy;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppLanguage.tr("Output folder", "출력 폴더"); width: 98px; color: AppTheme.text; vertical-alignment: center; }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.output-folder;
                    placeholder-text: AppLanguage.tr("Same as source by default", "기본값: 원본과 동일");
                    enabled: !root.busy;
                }
                Button {
                    text: AppLanguage.tr("Choose", "선택");
                    primary: false;
                    enabled: !root.busy;
                    clicked => { root.select-output-folder(); }
                }
                Button {
                    text: AppLanguage.tr("Reset", "초기화");
                    primary: false;
                    enabled: !root.busy && root.output-folder != "";
                    clicked => { root.output-folder = ""; }
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: AppTheme.surface;
        border-color: AppTheme.border;
        border-width: 1px;
        border-radius: 12px;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: AppLanguage.tr("Conversion queue (", "변환 대기 목록 (") + root.jobs.length + ")";
                    color: AppTheme.text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: AppLanguage.tr("Add files", "파일 추가"); enabled: !root.busy; clicked => { root.pick-files(); } }
                Button { text: AppLanguage.tr("Add folder", "폴더 추가"); enabled: !root.busy; clicked => { root.pick-folder(); } }
                Button { text: AppLanguage.tr("Remove completed", "완료항목 제거"); enabled: !root.busy && root.jobs.length > 0; clicked => { root.remove-completed-jobs(); } }
                Button { text: AppLanguage.tr("Clear queue", "목록 비우기"); enabled: !root.busy && root.jobs.length > 0; clicked => { root.clear-list(); } }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 120px;
                background: AppTheme.subtle-surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: AppTheme.separator;

                if root.jobs.length == 0 : Text {
                    text: AppLanguage.tr("Drag files or folders here", "파일이나 폴더를 드래그해서 추가하세요");
                    color: AppTheme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: LayoutAlignment.start;

                        for job[index] in root.jobs : HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: AppLanguage.job-status(job.status);
                                width: 66px;
                                color: job.status == JobStatus.Failed ? AppTheme.end : AppTheme.accent;
                                vertical-alignment: center;
                            }
                            QueueSource {
                                path: job.path;
                                info: job.source-info;
                            }
                            Button { text: AppLanguage.tr("Result", "결과"); enabled: !root.busy && AppLanguage.text(job.detail) != ""; clicked => { root.show-result(index); } }
                            Button { text: "↑"; width: 32px; enabled: !root.busy && index > 0; clicked => { root.move-job(index, -1); } }
                            Button { text: "↓"; width: 32px; enabled: !root.busy && index + 1 < root.jobs.length; clicked => { root.move-job(index, 1); } }
                            Button { text: AppLanguage.tr("Remove", "제거"); enabled: !root.busy; clicked => { root.remove-job(index); } }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Button {
            text: AppLanguage.tr("Start conversion", "변환 시작");
            primary: true;
            enabled: root.jobs.length > 0 && !root.busy && !root.other-job-running;
            clicked => { root.start(); }
        }
        Button { text: AppLanguage.tr("Cancel", "취소"); enabled: root.busy; clicked => { root.cancel(); } }
        Button { text: AppLanguage.tr("Retry failed", "실패만 재시도"); enabled: root.jobs.length > 0 && !root.busy && !root.other-job-running; clicked => { root.retry(); } }
        Rectangle { horizontal-stretch: 1; }
    }

    ProgressIndicator {
        height: 8px;
        progress: root.progress;
        indeterminate: root.busy && root.progress == 0;
    }

    Text { text: AppLanguage.text(root.status); color: AppTheme.text; wrap: word-wrap; }
    if AppLanguage.text(root.detail) != "": TextEdit {
        text: AppLanguage.text(root.detail);
        read-only: true;
        wrap: char-wrap;
        height: 112px;
        vertical-stretch: 0;
    }
}
