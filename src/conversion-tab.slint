import { Button, ComboBox, LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { FileNameText } from "file-name.slint";

export struct ConversionItem {
    id: int,
    path: string,
    source-info: string,
    status: string,
    detail: string,
}

export component ConversionTab inherits VerticalLayout {
    in property <[ConversionItem]> jobs;
    in property <string> output-folder;
    in property <bool> busy;
    in property <bool> other-job-running;
    in property <float> progress;
    in property <string> status;
    in property <string> detail;
    in-out property <int> format-index;
    in-out property <string> resize-width;
    in-out property <string> resize-height;
    callback pick-files();
    callback pick-folder();
    callback remove-job(int);
    callback move-job(int, int);
    callback clear-list();
    callback show-result(int);
    callback start();
    callback retry();
    callback cancel();

    padding: 10px;
    spacing: 12px;

    Rectangle {
        vertical-stretch: 0;
        background: AppTheme.surface;
        border-color: AppTheme.border;
        border-width: 1px;
        border-radius: 12px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text { text: "출력 형식"; width: 84px; color: AppTheme.text; vertical-alignment: center; }
                ComboBox {
                    width: 200px;
                    model: ["Animated GIF", "Animated WebP", "Animated AVIF"];
                    current-index <=> root.format-index;
                    enabled: !root.busy;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 10px;
                Text { text: "출력 크기"; width: 84px; color: AppTheme.text; vertical-alignment: center; }
                LineEdit {
                    width: 100px;
                    text <=> root.resize-width;
                    placeholder-text: "가로 (px)";
                    input-type: number;
                    enabled: !root.busy;
                }
                Text { text: "×"; color: AppTheme.muted; vertical-alignment: center; }
                LineEdit {
                    width: 100px;
                    text <=> root.resize-height;
                    placeholder-text: "세로 (px)";
                    input-type: number;
                    enabled: !root.busy;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "한쪽만 입력하면 비율 유지 · 모두 비우면 원본 크기";
                    color: AppTheme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text { text: "출력 폴더"; width: 84px; color: AppTheme.text; vertical-alignment: center; }
                Rectangle {
                    horizontal-stretch: 1;
                    folder-hover := TouchArea { }
                    FileNameText {
                        width: parent.width;
                        height: parent.height;
                        text: root.output-folder != "" ? root.output-folder : "원본과 같은 폴더";
                        hovered: folder-hover.has-hover;
                    }
                }
                Text { text: "인코딩 탭에서 설정"; color: AppTheme.muted; font-size: 12px; vertical-alignment: center; }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: AppTheme.surface;
        border-color: AppTheme.border;
        border-width: 1px;
        border-radius: 12px;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "변환 대기 목록 (" + root.jobs.length + ")";
                    color: AppTheme.text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "파일 추가"; enabled: !root.busy; clicked => { root.pick-files(); } }
                Button { text: "폴더 추가"; enabled: !root.busy; clicked => { root.pick-folder(); } }
                Button { text: "목록 비우기"; enabled: !root.busy && root.jobs.length > 0; clicked => { root.clear-list(); } }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 120px;
                background: AppTheme.subtle-surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: AppTheme.separator;

                if root.jobs.length == 0 : Text {
                    text: "파일이나 폴더를 드래그해서 추가하세요";
                    color: AppTheme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: LayoutAlignment.start;

                        for job[index] in root.jobs : HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: job.status;
                                width: 36px;
                                color: job.status == "실패" ? AppTheme.end : AppTheme.accent;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                name-area := TouchArea {
                                    min-width: 0px;
                                    height: 20px;
                                    file-name := FileNameText {
                                        width: 100%;
                                        height: 100%;
                                        text: job.path;
                                        font-size: 13px;
                                        hovered: name-area.has-hover;
                                    }
                                }
                                Text {
                                    text: job.source-info;
                                    color: AppTheme.muted;
                                    font-size: 12px;
                                    overflow: elide;
                                    min-width: 0px;
                                }
                            }
                            Button { text: "결과"; enabled: !root.busy && job.detail != ""; clicked => { root.show-result(index); } }
                            Button { text: "↑"; width: 32px; enabled: !root.busy && index > 0; clicked => { root.move-job(index, -1); } }
                            Button { text: "↓"; width: 32px; enabled: !root.busy && index + 1 < root.jobs.length; clicked => { root.move-job(index, 1); } }
                            Button { text: "제거"; enabled: !root.busy; clicked => { root.remove-job(index); } }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Button {
            text: "변환 시작";
            primary: true;
            enabled: root.jobs.length > 0 && !root.busy && !root.other-job-running;
            clicked => { root.start(); }
        }
        Button { text: "취소"; enabled: root.busy; clicked => { root.cancel(); } }
        Button { text: "실패만 재시도"; enabled: root.jobs.length > 0 && !root.busy && !root.other-job-running; clicked => { root.retry(); } }
        Rectangle { horizontal-stretch: 1; }
    }

    ProgressIndicator {
        height: 8px;
        progress: root.progress;
        indeterminate: root.busy && root.progress == 0;
    }

    Text { text: root.status; color: AppTheme.text; wrap: word-wrap; }
    if root.detail != "": TextEdit {
        text: root.detail;
        read-only: true;
        wrap: char-wrap;
        height: 112px;
        vertical-stretch: 0;
    }
}
