import { Button, LineEdit, Slider, HorizontalBox, VerticalBox, ProgressIndicator, ScrollView, CheckBox, TabWidget } from "std-widgets.slint";

// Custom ComboBox: 긴 파일명은 "…"으로 생략(elide)하고 드롭다운 화살표는 항상 표시한다.
component VideoFileComboBox {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);

    property <length> popup-padding: 4px;
    property <int> visible-items: min(6, model.length);
    property <length> item-height: 32px;

    min-width: 160px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.current-index = max(root.current-index - 1, 0);
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.current-index = min(root.current-index + 1, max(0, root.model.length - 1));
                return accept;
            } else if (event.text == Key.Return) {
                popup.show();
            }
            return reject;
        }

        box := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 3px;
            background: i-touch.pressed ? #e8e8ed : (i-touch.has-hover ? #f5f5f7 : #ffffff);
            border-width: 1px;
            border-color: #8a8a8e;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-left: 11px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: root.model[root.current-index];
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: #1d1d1f;
                        font-size: 14px;
                    }

                    Path {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        fill: #6e6e73;
                        commands: "M 1 3 L 9 3 L 5 8 Z";
                    }
                }
            }
        }

        i-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.focus();
                if (root.model.length > 0) {
                    popup.show();
                }
            }
        }
    }

    public function select(index: int) {
        if (index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        root.selected(index);
        popup.close();
    }

    popup := PopupWindow {
        x: 0px;
        y: -4px;
        width: max(root.width, 260px);
        height: root.visible-items * root.item-height + 2 * root.popup-padding;
        forward-focus: inner-fs;

        inner-fs := FocusScope {
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.current-index = max(root.current-index - 1, 0);
                    return accept;
                } else if (event.text == Key.DownArrow) {
                    root.current-index = min(root.current-index + 1, max(0, root.model.length - 1));
                    return accept;
                } else if (event.text == Key.Return) {
                    root.select(root.current-index);
                    return accept;
                } else if (event.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: #ffffff;
                border-radius: 7px;
                border-width: 1px;
                border-color: #d2d2d7;

                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        alignment: start;
                        padding: root.popup-padding;

                        for value[index] in root.model : item-touch := TouchArea {
                            width: 100%;
                            height: root.item-height;
                            clicked => {
                                root.select(index);
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 3px;
                                background: item-touch.pressed ? #e8e8ed : (item-touch.has-hover ? #f5f5f7 : (index == root.current-index ? #e8f0fe : transparent));

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: value;
                                        overflow: elide;
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        color: #1d1d1f;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "VideoEncoder FFmpeg Wrapper";
    icon: @image-url("app.png");
    default-font-family: "Segoe UI";
    min-width: 760px;
    min-height: 720px;
    background: #f5f5f7; // Soft Light Gray background

    // Callbacks to Rust
    callback select-ffmpeg-path();
    callback select-output-folder();
    callback reset-options();
    callback start-encoding();
    callback stop-encoding();
    callback pick-files();
    callback pick-folder();
    callback clear-list();
    
    // Custom callback for D&D trigger from Rust
    callback files-dropped(string);

    // --- Video editor callbacks ---
    callback pick-video();
    callback open-video();
    callback seek-time(float);
    callback mark-trim-start();
    callback mark-trim-end();
    callback trim-changed();
    callback crop-changed();
    callback toggle-play();
    callback run-cut();
    callback run-crop();
    callback reset-edit();

    // Properties from/to Rust
    in-out property <string> ffmpeg-path: "";
    in-out property <string> output-suffix: "_h265";
    in-out property <float> crf-value: 19.0;
    in-out property <string> output-folder: "";
    in-out property <[string]> file-list: [];
    in-out property <float> overall-progress: 0.0;
    in-out property <float> file-progress: 0.0;
    in-out property <string> overall-time-text: "";
    in-out property <string> current_file_text: "";
    in-out property <string> current_progress_text: "";
    in-out property <string> current_time_text: "";
    in-out property <bool> is-encoding: false;

    // --- Video editor properties ---
    in-out property <string> current-video-path: "";
    in-out property <image> video-image;
    in-out property <bool> video-loaded: false;
    in-out property <float> video-duration: 0.0;
    in-out property <float> video-fps: 30.0;
    in-out property <float> video-width: 0.0;
    in-out property <float> video-height: 0.0;
    in-out property <float> preview-time: 0.0;
    in-out property <float> trim-start: 0.0;
    in-out property <float> trim-end: 0.0;
    in-out property <float> crop-x: 0.0;
    in-out property <float> crop-y: 0.0;
    in-out property <float> crop-w: 1.0;
    in-out property <float> crop-h: 1.0;
    in-out property <bool> is-playing: false;
    in-out property <bool> edit-busy: false;
    in-out property <float> edit-progress: 0.0;
    in-out property <string> edit-status-text: "";
    in-out property <string> time-preview-text: "";
    in-out property <string> time-start-text: "";
    in-out property <string> time-end-text: "";
    in-out property <string> crop-info-text: "";
    in-out property <string> video-info-text: "";
    in-out property <int> selected-index: 0;

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            vertical-stretch: 0;
            text: "VideoEncoder FFmpeg Wrapper";
            font-size: 20px;
            font-weight: 700;
            color: #0071e3; // Apple blue accent
            horizontal-alignment: center;
        }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "인코딩";

                VerticalBox {
                    padding: 10px;
                    spacing: 12px;

        // Configuration Section
        Rectangle {
            vertical-stretch: 0;
            background: #ffffff; // White card
            border-radius: 12px;
            border-width: 1px;
            border-color: #d2d2d7;
            
            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "FFmpeg 경로:"; color: #1d1d1f; vertical-alignment: center; width: 100px; font-weight: 500; }
                    LineEdit {
                        text <=> ffmpeg-path;
                        placeholder-text: "ffmpeg.exe 경로를 지정하세요";
                    }
                    Button {
                        text: "찾아보기";
                        primary: false;
                        clicked => { select-ffmpeg-path(); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "출력 Suffix:"; color: #1d1d1f; vertical-alignment: center; width: 100px; font-weight: 500;}
                    LineEdit {
                        text <=> output-suffix;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        width: 100px;
                        alignment: center;
                        Text { text: "화질 (CRF):"; color: #1d1d1f; font-weight: 500; }
                        Text { text: "(Lower is better)"; color: #86868b; font-size: 10px; }
                    }
                    Slider {
                        minimum: 0;
                        maximum: 51;
                        value <=> crf-value;
                    }
                    Text { text: round(crf-value); color: #1d1d1f; vertical-alignment: center; width: 30px; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "출력 폴더:"; color: #1d1d1f; vertical-alignment: center; width: 100px; font-weight: 500; }
                    LineEdit {
                        text <=> output-folder;
                        placeholder-text: "기본값: 원본과 동일";
                    }
                    Button {
                        text: "선택";
                        primary: false;
                        clicked => { select-output-folder(); }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "옵션 초기화";
                        clicked => { reset-options(); }
                    }
                }
            }
        }

        // File List Section
        Rectangle {
            vertical-stretch: 1;
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #d2d2d7;
            
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    Text { text: "인코딩 대기 목록 (" + file-list.length + ")"; color: #1d1d1f; font-weight: 600; font-size: 16px; vertical-alignment: center; }
                    Rectangle {} // Spacer
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "파일 추가"; clicked => { pick-files(); } }
                        Button { text: "폴더 추가"; clicked => { pick-folder(); } }
                        Button { text: "목록 비우기"; clicked => { clear-list(); } }
                    }
                }
                
                // Content area
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    background: #fbfbfd;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e5e5e7;
                    
                    if (file-list.length == 0) : Text {
                        text: "파일이나 폴더를 드래그해서 추가하세요";
                        color: #86868b;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ScrollView {
                        VerticalBox {
                            alignment: start;
                            for file in file-list : Text {
                                text: file;
                                color: #1d1d1f;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }
        }

        // Progress Section
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            padding: 4px;
            height: 150px; 
            
            // Overall Section
            VerticalLayout {
                spacing: 4px;
                HorizontalBox {
                    padding: 0;
                    Text { text: "전체 진행도"; color: #1d1d1f; font-weight: 600; font-size: 14px; font-family: "Segoe UI"; }
                    Rectangle {} // Spacer
                    Text { text: overall-time-text; color: #86868b; font-size: 13px; vertical-alignment: bottom; font-family: "Segoe UI"; }
                }
                ProgressIndicator {
                    progress: overall-progress;
                    height: 10px;
                }
            }

            Rectangle { height: 1px; background: #e5e5e7; } // Separator

            // Current File Section
            VerticalLayout {
                spacing: 2px;
                Text { text: "현재 파일 진행"; color: #1d1d1f; font-weight: 500; font-size: 13px; font-family: "Segoe UI"; }
                
                // Filename (First line)
                Text {
                    text: current_file_text;
                    color: #1d1d1f;
                    font-size: 13px;
                    wrap: word-wrap;
                    height: 20px;
                    vertical-alignment: top;
                    font-family: "Segoe UI";
                }
                // Progress details (Second line)
                Text {
                    text: current_progress_text;
                    color: #1d1d1f;
                    font-size: 13px;
                    height: 20px;
                    font-family: "Segoe UI";
                }
                // Time info (Third line)
                Text {
                    text: current_time_text;
                    color: #86868b;
                    font-size: 13px;
                    height: 20px;
                    font-family: "Segoe UI";
                }

                ProgressIndicator {
                    progress: file_progress;
                    height: 8px;
                }
            }
        }

        // Controls Section
        HorizontalBox {
            vertical-stretch: 0;
            spacing: 24px;
            alignment: center;
            
            Button {
                text: "변환 시작";
                primary: true;
                enabled: !is-encoding && file-list.length > 0;
                clicked => { start-encoding(); }
                height: 36px;
                width: 180px;
            }
            
            Button {
                text: "중단";
                enabled: is-encoding;
                clicked => { stop-encoding(); }
                height: 36px;
                width: 180px;
            }
        }
                }
            }

            Tab {
                title: "잘라내기 / 크롭";

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    // Video source row
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "비디오:"; color: #1d1d1f; width: 60px; vertical-alignment: center; font-weight: 500; }
                        VideoFileComboBox {
                            model: file-list;
                            current-index <=> selected-index;
                            selected => { open-video(); }
                        }
                        Button { text: "열기"; clicked => { open-video(); } }
                        Button { text: "파일 선택..."; clicked => { pick-video(); } }
                    }

                    Text {
                        text: video-info-text;
                        color: #86868b;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Preview area
                    preview-area := Rectangle {
                        vertical-stretch: 1;
                        min-height: 240px;
                        background: #1d1d1f;
                        border-radius: 8px;
                        clip: true;
                        property <length> area-w: self.width;
                        property <length> area-h: self.height;
                        property <length> disp-w: min(area-w, area-h * (video-width / max(1.0, video-height)));
                        property <length> disp-h: min(area-h, area-w * (max(1.0, video-height) / max(1.0, video-width)));

                        if (!video-loaded) : Text {
                            text: "비디오를 선택하면 여기에 미리보기가 표시됩니다";
                            color: #86868b;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if (video-loaded) : Rectangle {
                            x: (parent.area-w - parent.disp-w) / 2;
                            y: (parent.area-h - parent.disp-h) / 2;
                            width: parent.disp-w;
                            height: parent.disp-h;
                            background: #000000;

                            Image {
                                source: video-image;
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }

                            // Crop overlay
                            Rectangle {
                                x: crop-x * parent.width;
                                y: crop-y * parent.height;
                                width: crop-w * parent.width;
                                height: crop-h * parent.height;
                                border-width: 2px;
                                border-color: #ff3b30;
                                background: #ff3b3014;

                                property <float> drag-orig-x: 0.0;
                                property <float> drag-orig-y: 0.0;
                                property <float> drag-cursor-x: 0.0;
                                property <float> drag-cursor-y: 0.0;
                                // Edge drag origin snapshots
                                property <float> top-orig-y: 0.0;
                                property <float> top-orig-b: 1.0;
                                property <float> top-cursor-y: 0.0;
                                property <float> bot-orig-h: 1.0;
                                property <float> bot-cursor-y: 0.0;
                                property <float> left-orig-x: 0.0;
                                property <float> left-orig-r: 1.0;
                                property <float> left-cursor-x: 0.0;
                                property <float> right-orig-w: 1.0;
                                property <float> right-cursor-x: 0.0;

                                // Drag to move the crop area
                                TouchArea {
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            drag-orig-x = crop-x;
                                            drag-orig-y = crop-y;
                                            drag-cursor-x = (parent.x + self.mouse-x) / preview-area.disp-w;
                                            drag-cursor-y = (parent.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-x = clamp(drag-orig-x + (parent.x + self.mouse-x) / preview-area.disp-w - drag-cursor-x, 0.0, 1.0 - crop-w);
                                            crop-y = clamp(drag-orig-y + (parent.y + self.mouse-y) / preview-area.disp-h - drag-cursor-y, 0.0, 1.0 - crop-h);
                                            crop-changed();
                                        }
                                    }
                                }

                                // Top edge handle (세로 크기 조절)
                                Rectangle {
                                    x: 0px;
                                    y: -5px;
                                    width: 100%;
                                    height: 10px;
                                    background: #ff3b3014;

                                    Rectangle {
                                        y: 4px;
                                        width: 100%;
                                        height: 2px;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: 0px;
                                    y: -5px;
                                    width: 100%;
                                    height: 10px;
                                    mouse-cursor: ns-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            top-orig-y = crop-y;
                                            top-orig-b = crop-y + crop-h;
                                            top-cursor-y = (parent.y + self.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-y = clamp(top-orig-y + (parent.y + self.y + self.mouse-y) / preview-area.disp-h - top-cursor-y, 0.0, max(0.0, top-orig-b - 0.05));
                                            crop-h = top-orig-b - crop-y;
                                            crop-changed();
                                        }
                                    }
                                }

                                // Bottom edge handle (세로 크기 조절)
                                Rectangle {
                                    x: 0px;
                                    y: parent.height - 5px;
                                    width: 100%;
                                    height: 10px;
                                    background: #ff3b3014;

                                    Rectangle {
                                        y: 4px;
                                        width: 100%;
                                        height: 2px;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: 0px;
                                    y: parent.height - 5px;
                                    width: 100%;
                                    height: 10px;
                                    mouse-cursor: ns-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            bot-orig-h = crop-h;
                                            bot-cursor-y = (parent.y + self.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-h = clamp(bot-orig-h + (parent.y + self.y + self.mouse-y) / preview-area.disp-h - bot-cursor-y, 0.05, 1.0 - crop-y);
                                            crop-changed();
                                        }
                                    }
                                }

                                // Left edge handle (가로 크기 조절)
                                Rectangle {
                                    x: -5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    background: #ff3b3014;

                                    Rectangle {
                                        x: 4px;
                                        width: 2px;
                                        height: 100%;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: -5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    mouse-cursor: ew-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            left-orig-x = crop-x;
                                            left-orig-r = crop-x + crop-w;
                                            left-cursor-x = (parent.x + self.x + self.mouse-x) / preview-area.disp-w;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-x = clamp(left-orig-x + (parent.x + self.x + self.mouse-x) / preview-area.disp-w - left-cursor-x, 0.0, max(0.0, left-orig-r - 0.05));
                                            crop-w = left-orig-r - crop-x;
                                            crop-changed();
                                        }
                                    }
                                }

                                // Right edge handle (가로 크기 조절)
                                Rectangle {
                                    x: parent.width - 5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    background: #ff3b3014;

                                    Rectangle {
                                        x: 4px;
                                        width: 2px;
                                        height: 100%;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: parent.width - 5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    mouse-cursor: ew-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            right-orig-w = crop-w;
                                            right-cursor-x = (parent.x + self.x + self.mouse-x) / preview-area.disp-w;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-w = clamp(right-orig-w + (parent.x + self.x + self.mouse-x) / preview-area.disp-w - right-cursor-x, 0.05, 1.0 - crop-x);
                                            crop-changed();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Timeline
                    Rectangle {
                        height: 34px;
                        property <length> tl-w: self.width;
                        property <bool> tl-dragging: false;
                        property <bool> start-dragging: false;
                        property <bool> end-dragging: false;

                        // Track
                        Rectangle {
                            y: 14px;
                            height: 6px;
                            width: 100%;
                            background: #3a3a3c;
                            border-radius: 3px;
                        }

                        // Trim range highlight
                        Rectangle {
                            x: trim-start / max(video-duration, 0.01) * tl-w;
                            y: 8px;
                            width: max(0px, (trim-end - trim-start) / max(video-duration, 0.01) * tl-w);
                            height: 18px;
                            background: #30d15859;
                            border-radius: 4px;
                        }

                        // Whole-bar seek (click/drag to move playhead)
                        TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    tl-dragging = true;
                                    seek-time(clamp(self.mouse-x / tl-w * video-duration, 0.0, video-duration));
                                } else if (ev.kind == PointerEventKind.up) {
                                    tl-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && tl-dragging) {
                                    seek-time(clamp(self.mouse-x / tl-w * video-duration, 0.0, video-duration));
                                }
                            }
                        }

                        // Playhead (visual only)
                        Rectangle {
                            x: preview-time / max(video-duration, 0.01) * tl-w - 3px;
                            y: 0px;
                            width: 6px;
                            height: 34px;
                            background: #0071e3;
                            border-radius: 3px;
                        }

                        // Start marker
                        Rectangle {
                            x: trim-start / max(video-duration, 0.01) * tl-w - 7px;
                            y: 11px;
                            width: 14px;
                            height: 12px;
                            background: #ff9f0a;
                            border-radius: 4px;
                            TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down) {
                                        start-dragging = true;
                                    } else if (ev.kind == PointerEventKind.up) {
                                        start-dragging = false;
                                    } else if (ev.kind == PointerEventKind.move && start-dragging) {
                                        trim-start = clamp((self.mouse-x + parent.x) / tl-w * video-duration, 0.0, max(0.0, trim-end - 0.05));
                                        trim-changed();
                                        seek-time(trim-start);
                                    }
                                }
                            }
                        }

                        // End marker
                        Rectangle {
                            x: trim-end / max(video-duration, 0.01) * tl-w - 7px;
                            y: 11px;
                            width: 14px;
                            height: 12px;
                            background: #30d158;
                            border-radius: 4px;
                            TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down) {
                                        end-dragging = true;
                                    } else if (ev.kind == PointerEventKind.up) {
                                        end-dragging = false;
                                    } else if (ev.kind == PointerEventKind.move && end-dragging) {
                                        trim-end = clamp((self.mouse-x + parent.x) / tl-w * video-duration, trim-start + 0.05, video-duration);
                                        trim-changed();
                                        seek-time(trim-end);
                                    }
                                }
                            }
                        }
                    }

                    // Time labels
                    HorizontalLayout {
                        Text { text: "시작 " + time-start-text; color: #ff9f0a; font-size: 12px; width: 130px; }
                        Rectangle {}
                        Text { text: time-preview-text; color: #0071e3; font-size: 12px; }
                        Rectangle {}
                        Text { text: "끝 " + time-end-text; color: #30d158; font-size: 12px; width: 130px; }
                    }

                    // Trim sliders
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "시작:"; width: 42px; color: #1d1d1f; vertical-alignment: center; font-size: 12px; }
                        Slider {
                            value <=> trim-start;
                            minimum: 0;
                            maximum: max(video-duration, 0.01);
                            changed => { trim-changed(); seek-time(trim-start); }
                            vertical-stretch: 1;
                        }
                        Text { text: "끝:"; width: 32px; color: #1d1d1f; vertical-alignment: center; font-size: 12px; }
                        Slider {
                            value <=> trim-end;
                            minimum: 0;
                            maximum: max(video-duration, 0.01);
                            changed => { trim-changed(); seek-time(trim-end); }
                            vertical-stretch: 1;
                        }
                    }

                    Text { text: crop-info-text; color: #86868b; font-size: 12px; }

                    // Marker & play buttons
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "시작점 ← 현재"; enabled: video-loaded && !edit-busy; clicked => { mark-trim-start(); } }
                        Button { text: "끝점 ← 현재"; enabled: video-loaded && !edit-busy; clicked => { mark-trim-end(); } }
                        Button { text: is-playing ? "⏸" : "▶"; enabled: video-loaded && !edit-busy; clicked => { toggle-play(); } }
                        Button { text: "편집 초기화"; enabled: video-loaded && !edit-busy; clicked => { reset-edit(); } }
                    }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "잘라내기 실행 (무손실)";
                            primary: true;
                            enabled: video-loaded && !edit-busy && (trim-end - trim-start) > 0.05;
                            clicked => { run-cut(); }
                        }
                        Button {
                            text: "크롭 + 컷 실행";
                            primary: true;
                            enabled: video-loaded && !edit-busy && (trim-end - trim-start) > 0.05;
                            clicked => { run-crop(); }
                        }
                    }

                    ProgressIndicator {
                        progress: edit-progress;
                        height: 8px;
                    }

                    Text {
                        text: edit-status-text;
                        wrap: word-wrap;
                        color: #1d1d1f;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
