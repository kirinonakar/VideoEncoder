import { AppLanguage, JobStatus, LocalizedText, LanguageComboBox } from "language.slint";
import { Button, ComboBox, LineEdit, Slider, HorizontalBox, VerticalBox, ProgressIndicator, ScrollView, CheckBox, TabWidget, Palette } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { EditorTimeline } from "editor-timeline.slint";
import { FileNameText, FileNameTooltip, FileNameTooltipLayer, QueueSource } from "file-name.slint";
import { ConversionItem, ConversionTab } from "conversion-tab.slint";

// Custom ComboBox: 긴 파일명은 "…"으로 생략(elide)하고 드롭다운 화살표는 항상 표시한다.
component VideoFileComboBox {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);

    property <length> popup-padding: 4px;
    property <int> visible-items: min(6, model.length);
    property <length> item-height: 32px;

    min-width: 160px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.current-index = max(root.current-index - 1, 0);
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.current-index = min(root.current-index + 1, max(0, root.model.length - 1));
                return accept;
            } else if (event.text == Key.Return) {
                FileNameTooltip.text = "";
                popup.show();
            }
            return reject;
        }

        box := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 3px;
            background: i-touch.pressed ? AppTheme.pressed : (i-touch.has-hover ? AppTheme.hover : AppTheme.surface);
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-left: 11px;
                    padding-right: 8px;
                    spacing: 8px;

                    FileNameText {
                        text: root.model[root.current-index];
                        hovered: i-touch.has-hover && !i-touch.pressed;
                    }

                    Path {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        fill: AppTheme.muted;
                        commands: "M 1 3 L 9 3 L 5 8 Z";
                    }
                }
            }
        }

        i-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.focus();
                if (root.model.length > 0) {
                    FileNameTooltip.text = "";
                    popup.show();
                }
            }
        }
    }

    public function select(index: int) {
        if (index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        root.selected(index);
        FileNameTooltip.text = "";
        popup.close();
    }

    popup := PopupWindow {
        x: 0px;
        y: -4px;
        width: max(root.width, 260px);
        height: root.visible-items * root.item-height + 2 * root.popup-padding;
        forward-focus: inner-fs;

        inner-fs := FocusScope {
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.current-index = max(root.current-index - 1, 0);
                    return accept;
                } else if (event.text == Key.DownArrow) {
                    root.current-index = min(root.current-index + 1, max(0, root.model.length - 1));
                    return accept;
                } else if (event.text == Key.Return) {
                    root.select(root.current-index);
                    return accept;
                } else if (event.text == Key.Escape) {
                    FileNameTooltip.text = "";
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: AppTheme.surface;
                border-radius: 7px;
                border-width: 1px;
                border-color: AppTheme.border;

                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        alignment: start;
                        padding: root.popup-padding;

                        for value[index] in root.model : item-touch := TouchArea {
                            width: 100%;
                            height: root.item-height;
                            clicked => {
                                root.select(index);
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 3px;
                                background: item-touch.pressed ? AppTheme.pressed : (item-touch.has-hover ? AppTheme.hover : (index == root.current-index ? AppTheme.selected : transparent));

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    FileNameText {
                                        text: value;
                                        hovered: item-touch.has-hover && !item-touch.pressed;
                                        in-popup: true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        FileNameTooltipLayer { in-popup: true; }
    }
}

export { JobStatus, LocalizedText }

export struct JobItem { id: int, path: string, source-info: LocalizedText, status: JobStatus, detail: LocalizedText }

export component MainWindow inherits Window {
    title: "VideoEncoder FFmpeg Wrapper";
    icon: @image-url("app.png");
    default-font-family: "Segoe UI";
    min-width: 760px;
    min-height: 720px;
    background: AppTheme.background;
    in-out property <bool> korean <=> AppLanguage.korean;
    in-out property <bool> dark-mode <=> AppTheme.dark-mode;
    out property <color> titlebar-background: AppTheme.background;
    out property <color> titlebar-foreground: AppTheme.text;
    callback native-theme-changed();
    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        native-theme-changed();
    }

    // Callbacks to Rust
    callback select-ffmpeg-path();
    callback refresh-ffmpeg-path();
    callback select-output-folder();
    callback reset-options();
    callback start-encoding();
    callback stop-encoding();
    callback pick-files();
    callback pick-folder();
    callback clear-list();
    callback remove-job(int);
    callback move-job(int, int);
    callback retry-failed();
    callback save-settings();
    callback export-preset();
    callback import-preset();
    callback cancel-edit();
    in-out property <[JobItem]> job-list;
    in-out property <LocalizedText> error-details;
    in-out property <bool> all-audio: true;
    in-out property <bool> preserve-subtitles: false;
    in-out property <int> cut-mode: 0;
    
    // Custom callback for D&D trigger from Rust
    callback files-dropped(string);

    // --- Video editor callbacks ---
    callback pick-video();
    callback open-video();
    callback seek-time(float);
    callback mark-trim-start();
    callback mark-trim-end();
    callback trim-changed();
    callback crop-changed();
    callback toggle-play();
    callback playback-limit-changed();
    callback rewind();
    callback run-edit();
    callback reset-edit();

    // Properties from/to Rust
    in-out property <string> ffmpeg-path: "";
    in-out property <string> output-suffix: "_h265";
    // 0 = x265 (CPU), 1 = NVENC (hevc_nvenc)
    in-out property <int> encoder-index: 1;
    in-out property <float> crf-value: 19.0;
    in-out property <float> cq-value: 20.0;
    in-out property <string> output-folder: "";
    in-out property <[string]> file-list: [];
    in-out property <float> overall-progress: 0.0;
    in-out property <float> file-progress: 0.0;
    in-out property <LocalizedText> overall-time-text;
    in-out property <LocalizedText> current_file_text;
    in-out property <LocalizedText> current_progress_text;
    in-out property <LocalizedText> current_time_text;
    in-out property <bool> is-encoding: false;

    // --- Video editor properties ---
    in-out property <string> current-video-path: "";
    in-out property <image> video-image;
    in-out property <bool> video-loaded: false;
    in-out property <float> video-duration: 0.0;
    in-out property <float> video-fps: 30.0;
    in-out property <float> video-width: 0.0;
    in-out property <float> video-height: 0.0;
    in-out property <float> preview-time: 0.0;
    in-out property <float> trim-start: 0.0;
    in-out property <float> trim-end: 0.0;
    in-out property <float> crop-x: 0.0;
    in-out property <float> crop-y: 0.0;
    in-out property <float> crop-w: 1.0;
    in-out property <float> crop-h: 1.0;
    in-out property <bool> is-playing: false;
    in-out property <bool> playback-limited: false;
    in-out property <bool> edit-busy: false;
    in-out property <float> edit-progress: 0.0;
    in-out property <LocalizedText> edit-status-text;
    in-out property <string> time-preview-text: "";
    in-out property <string> time-start-text: "";
    in-out property <string> time-end-text: "";
    in-out property <LocalizedText> crop-info-text;
    in-out property <LocalizedText> video-info-text;
    in-out property <int> selected-index: 0;

    callback pick-conversion-files();
    callback pick-conversion-folder();
    callback conversion-files-dropped(string);
    callback remove-conversion-job(int);
    callback move-conversion-job(int, int);
    callback clear-conversion-list();
    callback show-conversion-result(int);
    callback conversion-options-changed();
    callback start-conversion(bool);
    callback cancel-conversion();
    in-out property <int> active-tab;
    out property <bool> conversion-tab-active: active-tab == 2;
    in-out property <[ConversionItem]> conversion-jobs;
    in-out property <int> conversion-format;
    in-out property <string> conversion-width;
    in-out property <string> conversion-height;
    in-out property <bool> conversion-busy;
    in-out property <float> conversion-progress;
    in-out property <LocalizedText> conversion-status;
    in-out property <LocalizedText> conversion-detail;

    changed conversion-format => { conversion-options-changed(); }
    changed conversion-width => { conversion-options-changed(); }
    changed conversion-height => { conversion-options-changed(); }

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Keep the title centered with both toggles at the far right.
        Rectangle {
            height: 36px;
            vertical-stretch: 0;
            Text {
                x: theme-toggle.width + language-toggle.width + 6px;
                width: parent.width - 2 * self.x;
                height: 100%;
                text: "VideoEncoder FFmpeg Wrapper";
                font-size: 20px;
                font-weight: 700;
                color: AppTheme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            language-toggle := Button {
                x: theme-toggle.x - self.width - 6px;
                width: 44px;
                height: 36px;
                text: root.korean ? "KO" : "EN";
                accessible-label: root.korean ? "영어로 전환 (EN)" : "Switch to Korean (KO)";
                clicked => { root.korean = !root.korean; }
            }
            theme-toggle := Button {
                x: parent.width - self.width;
                width: 44px;
                height: 36px;
                accessible-label: root.dark-mode ? AppLanguage.tr("Switch to light mode", "라이트 모드로 전환") : AppLanguage.tr("Switch to dark mode", "다크 모드로 전환");
                icon: root.dark-mode ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                icon-size: 18px;
                colorize-icon: true;
                checkable: true;
                checked <=> root.dark-mode;
            }
        }

        TabWidget {
            vertical-stretch: 1;
            current-index <=> root.active-tab;

            Tab {
                title: AppLanguage.tr("Encode", "인코딩");

                VerticalBox {
                    padding: 10px;
                    spacing: 12px;

        // Configuration Section
        Rectangle {
            vertical-stretch: 0;
            background: AppTheme.surface; // Themed card
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;
            
            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: AppLanguage.tr("FFmpeg path:", "FFmpeg 경로:"); color: AppTheme.text; vertical-alignment: center; width: 100px; font-weight: 500; }
                    LineEdit {
                        text <=> ffmpeg-path;
                        placeholder-text: AppLanguage.tr("Select ffmpeg.exe", "ffmpeg.exe 경로를 지정하세요");
                    }
                    Button {
                        text: AppLanguage.tr("Auto-detect", "자동선택");
                        enabled: !is-encoding && !edit-busy;
                        clicked => { refresh-ffmpeg-path(); }
                    }
                    Button {
                        text: AppLanguage.tr("Browse", "찾아보기");
                        primary: false;
                        clicked => { select-ffmpeg-path(); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: AppLanguage.tr("Output suffix:", "출력 Suffix:"); color: AppTheme.text; vertical-alignment: center; width: 100px; font-weight: 500;}
                    LineEdit {
                        text <=> output-suffix;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: AppLanguage.tr("Encoder:", "인코더:"); color: AppTheme.text; vertical-alignment: center; width: 100px; font-weight: 500; }
                    ComboBox {
                        model: ["x265 (CPU)", "NVENC (H.265)"];
                        current-index <=> encoder-index;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        width: 100px;
                        alignment: center;
                        Text { text: encoder-index == 0 ? AppLanguage.tr("Quality (CRF):", "화질 (CRF):") : AppLanguage.tr("Quality (CQ):", "화질 (CQ):"); color: AppTheme.text; font-weight: 500; }
                        Text { text: AppLanguage.tr("(Lower is better)", "(낮을수록 고화질)"); color: AppTheme.muted; font-size: 10px; }
                    }
                    if (encoder-index == 0) : Slider {
                        minimum: 0;
                        maximum: 51;
                        value <=> crf-value;
                    }
                    if (encoder-index == 0) : Text { text: round(crf-value); color: AppTheme.text; vertical-alignment: center; width: 30px; }
                    if (encoder-index == 1) : Slider {
                        minimum: 0;
                        maximum: 51;
                        value <=> cq-value;
                    }
                    if (encoder-index == 1) : Text { text: round(cq-value); color: AppTheme.text; vertical-alignment: center; width: 30px; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: AppLanguage.tr("Output folder:", "출력 폴더:"); color: AppTheme.text; vertical-alignment: center; width: 100px; font-weight: 500; }
                    LineEdit {
                        text <=> output-folder;
                        placeholder-text: AppLanguage.tr("Same as source by default", "기본값: 원본과 동일");
                    }
                    Button {
                        text: AppLanguage.tr("Choose", "선택");
                        primary: false;
                        clicked => { select-output-folder(); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    CheckBox { text: AppLanguage.tr("All audio tracks", "모든 오디오 트랙"); checked <=> all-audio; enabled: !is-encoding && !edit-busy; }
                    CheckBox { text: AppLanguage.tr("Keep subtitles", "자막 보존"); checked <=> preserve-subtitles; enabled: !is-encoding && !edit-busy; }
                    Text { text: AppLanguage.tr("MP4: Incompatible audio → AAC / text subtitles → mov_text", "MP4: 비호환 오디오는 AAC / 텍스트 자막은 mov_text"); color: AppTheme.muted; font-size: 11px; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        enabled: !is-encoding && !edit-busy;
                        text: AppLanguage.tr("Reset options", "옵션 초기화");
                        clicked => { reset-options(); }
                    }
                    Button { text: AppLanguage.tr("Save settings", "설정 저장"); clicked => { save-settings(); } }
                    Button { text: AppLanguage.tr("Save preset", "프리셋 저장"); clicked => { export-preset(); } }
                    Button { text: AppLanguage.tr("Load preset", "프리셋 열기"); enabled: !is-encoding && !edit-busy; clicked => { import-preset(); } }
                }
            }
        }

        // File List Section
        Rectangle {
            vertical-stretch: 1;
            background: AppTheme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;
            
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    Text { text: AppLanguage.tr("Encoding queue (", "인코딩 대기 목록 (") + file-list.length + ")"; color: AppTheme.text; font-weight: 600; font-size: 16px; vertical-alignment: center; }
                    Rectangle {} // Spacer
                    HorizontalLayout {
                        spacing: 8px;
                        Button { enabled: !is-encoding; text: AppLanguage.tr("Add files", "파일 추가"); clicked => { pick-files(); } }
                        Button { enabled: !is-encoding; text: AppLanguage.tr("Add folder", "폴더 추가"); clicked => { pick-folder(); } }
                        Button { enabled: !is-encoding; text: AppLanguage.tr("Clear queue", "목록 비우기"); clicked => { clear-list(); } }
                    }
                }
                
                // Content area
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    background: AppTheme.subtle-surface;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppTheme.separator;
                    
                    if (file-list.length == 0) : Text {
                        text: AppLanguage.tr("Drag files or folders here", "파일이나 폴더를 드래그해서 추가하세요");
                        color: AppTheme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ScrollView {
                        VerticalBox {
                            alignment: start;
                            for job[index] in job-list : HorizontalLayout {
                                spacing: 6px;
                                Text { text: AppLanguage.job-status(job.status); color: job.status == JobStatus.Failed ? #d33f49 : AppTheme.accent; width: 66px; vertical-alignment: center; font-family: "Noto Sans CJK JP"; }
                                QueueSource {
                                    path: job.path;
                                    info: job.source-info;
                                }
                                Button { text: "↑"; width: 32px; enabled: !is-encoding && index > 0; clicked => { move-job(index, -1); } }
                                Button { text: "↓"; width: 32px; enabled: !is-encoding && index + 1 < job-list.length; clicked => { move-job(index, 1); } }
                                Button { text: AppLanguage.tr("Remove", "제거"); enabled: !is-encoding; clicked => { remove-job(index); } }
                            }
                        }
                    }
                }
            }
        }

        // Progress Section
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            padding: 4px;
            height: 150px; 
            
            // Overall Section
            VerticalLayout {
                spacing: 4px;
                HorizontalBox {
                    padding: 0;
                    Text { text: AppLanguage.tr("Overall progress", "전체 진행도"); color: AppTheme.text; font-weight: 600; font-size: 14px; font-family: "Segoe UI"; }
                    Rectangle {} // Spacer
                    Text { text: AppLanguage.text(overall-time-text); color: AppTheme.muted; font-size: 13px; vertical-alignment: bottom; font-family: "Segoe UI"; }
                }
                ProgressIndicator {
                    progress: overall-progress;
                    height: 10px;
                }
            }

            Rectangle { height: 1px; background: AppTheme.separator; } // Separator

            // Current File Section
            VerticalLayout {
                spacing: 2px;
                Text { text: AppLanguage.tr("Current file progress", "현재 파일 진행"); color: AppTheme.text; font-weight: 500; font-size: 13px; font-family: "Segoe UI"; }
                
                // Filename (First line)
                Text {
                    text: AppLanguage.text(current_file_text);
                    color: AppTheme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                    height: 20px;
                    vertical-alignment: top;
                    font-family: "Segoe UI";
                }
                // Progress details (Second line)
                Text {
                    text: AppLanguage.text(current_progress_text);
                    color: AppTheme.text;
                    font-size: 13px;
                    height: 20px;
                    font-family: "Segoe UI";
                }
                // Time info (Third line)
                Text {
                    text: AppLanguage.text(current_time_text);
                    color: AppTheme.muted;
                    font-size: 13px;
                    height: 20px;
                    font-family: "Segoe UI";
                }

                ProgressIndicator {
                    progress: file_progress;
                    height: 8px;
                }
            }
        }

        // Controls Section
        HorizontalBox {
            vertical-stretch: 0;
            spacing: 24px;
            alignment: center;
            
            Button {
                text: AppLanguage.tr("Start encoding", "인코딩 시작");
                primary: true;
                enabled: !is-encoding && !edit-busy && !conversion-busy && file-list.length > 0;
                clicked => { start-encoding(); }
                height: 36px;
                width: 180px;
            }
            
            Button {
                text: AppLanguage.tr("Stop", "중단");
                enabled: is-encoding;
                clicked => { stop-encoding(); }
                height: 36px;
                width: 120px;
            }
            Button { text: AppLanguage.tr("Retry failed", "실패만 재시도"); enabled: !is-encoding && !edit-busy && !conversion-busy; clicked => { retry-failed(); } }
        }
                }
            }

            Tab {
                title: AppLanguage.tr("Trim / Crop", "잘라내기 / 크롭");

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    // Video source row
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: AppLanguage.tr("Video:", "비디오:"); color: AppTheme.text; width: 60px; vertical-alignment: center; font-weight: 500; }
                        VideoFileComboBox {
                            model: file-list;
                            current-index <=> selected-index;
                            selected => { open-video(); }
                        }
                        Button { text: AppLanguage.tr("Open", "열기"); clicked => { open-video(); } }
                        Button { enabled: !is-encoding && !edit-busy; text: AppLanguage.tr("Choose file…", "파일 선택..."); clicked => { pick-video(); } }
                    }

                    Text {
                        text: AppLanguage.text(video-info-text);
                        color: AppTheme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Preview area
                    preview-area := Rectangle {
                        vertical-stretch: 1;
                        min-height: 240px;
                        background: #1d1d1f;
                        border-radius: 8px;
                        clip: true;
                        property <length> area-w: self.width;
                        property <length> area-h: self.height;
                        property <length> disp-w: min(area-w, area-h * (video-width / max(1.0, video-height)));
                        property <length> disp-h: min(area-h, area-w * (max(1.0, video-height) / max(1.0, video-width)));

                        if (!video-loaded) : Text {
                            text: AppLanguage.tr("Select a video to see its preview here", "비디오를 선택하면 여기에 미리보기가 표시됩니다");
                            color: #a4adbb;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if (video-loaded) : Rectangle {
                            x: (parent.area-w - parent.disp-w) / 2;
                            y: (parent.area-h - parent.disp-h) / 2;
                            width: parent.disp-w;
                            height: parent.disp-h;
                            background: #000000;

                            Image {
                                source: video-image;
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }

                            // Crop overlay
                            Rectangle {
                                x: crop-x * parent.width;
                                y: crop-y * parent.height;
                                width: crop-w * parent.width;
                                height: crop-h * parent.height;
                                border-width: 2px;
                                border-color: #ff3b30;
                                background: #ff3b3014;

                                property <float> drag-orig-x: 0.0;
                                property <float> drag-orig-y: 0.0;
                                property <float> drag-cursor-x: 0.0;
                                property <float> drag-cursor-y: 0.0;
                                // Edge drag origin snapshots
                                property <float> top-orig-y: 0.0;
                                property <float> top-orig-b: 1.0;
                                property <float> top-cursor-y: 0.0;
                                property <float> bot-orig-h: 1.0;
                                property <float> bot-cursor-y: 0.0;
                                property <float> left-orig-x: 0.0;
                                property <float> left-orig-r: 1.0;
                                property <float> left-cursor-x: 0.0;
                                property <float> right-orig-w: 1.0;
                                property <float> right-cursor-x: 0.0;

                                // Drag to move the crop area
                                TouchArea {
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            drag-orig-x = crop-x;
                                            drag-orig-y = crop-y;
                                            drag-cursor-x = (parent.x + self.mouse-x) / preview-area.disp-w;
                                            drag-cursor-y = (parent.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-x = clamp(drag-orig-x + (parent.x + self.mouse-x) / preview-area.disp-w - drag-cursor-x, 0.0, 1.0 - crop-w);
                                            crop-y = clamp(drag-orig-y + (parent.y + self.mouse-y) / preview-area.disp-h - drag-cursor-y, 0.0, 1.0 - crop-h);
                                            crop-changed();
                                        }
                                    }
                                }

                                // Top edge handle (세로 크기 조절)
                                Rectangle {
                                    x: 0px;
                                    y: -5px;
                                    width: 100%;
                                    height: 10px;
                                    background: #ff3b3014;

                                    Rectangle {
                                        y: 4px;
                                        width: 100%;
                                        height: 2px;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: 0px;
                                    y: -5px;
                                    width: 100%;
                                    height: 10px;
                                    mouse-cursor: ns-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            top-orig-y = crop-y;
                                            top-orig-b = crop-y + crop-h;
                                            top-cursor-y = (parent.y + self.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-y = clamp(top-orig-y + (parent.y + self.y + self.mouse-y) / preview-area.disp-h - top-cursor-y, 0.0, max(0.0, top-orig-b - 0.05));
                                            crop-h = top-orig-b - crop-y;
                                            crop-changed();
                                        }
                                    }
                                }

                                // Bottom edge handle (세로 크기 조절)
                                Rectangle {
                                    x: 0px;
                                    y: parent.height - 5px;
                                    width: 100%;
                                    height: 10px;
                                    background: #ff3b3014;

                                    Rectangle {
                                        y: 4px;
                                        width: 100%;
                                        height: 2px;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: 0px;
                                    y: parent.height - 5px;
                                    width: 100%;
                                    height: 10px;
                                    mouse-cursor: ns-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            bot-orig-h = crop-h;
                                            bot-cursor-y = (parent.y + self.y + self.mouse-y) / preview-area.disp-h;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-h = clamp(bot-orig-h + (parent.y + self.y + self.mouse-y) / preview-area.disp-h - bot-cursor-y, 0.05, 1.0 - crop-y);
                                            crop-changed();
                                        }
                                    }
                                }

                                // Left edge handle (가로 크기 조절)
                                Rectangle {
                                    x: -5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    background: #ff3b3014;

                                    Rectangle {
                                        x: 4px;
                                        width: 2px;
                                        height: 100%;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: -5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    mouse-cursor: ew-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            left-orig-x = crop-x;
                                            left-orig-r = crop-x + crop-w;
                                            left-cursor-x = (parent.x + self.x + self.mouse-x) / preview-area.disp-w;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-x = clamp(left-orig-x + (parent.x + self.x + self.mouse-x) / preview-area.disp-w - left-cursor-x, 0.0, max(0.0, left-orig-r - 0.05));
                                            crop-w = left-orig-r - crop-x;
                                            crop-changed();
                                        }
                                    }
                                }

                                // Right edge handle (가로 크기 조절)
                                Rectangle {
                                    x: parent.width - 5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    background: #ff3b3014;

                                    Rectangle {
                                        x: 4px;
                                        width: 2px;
                                        height: 100%;
                                        background: #ff3b30;
                                    }
                                }

                                TouchArea {
                                    x: parent.width - 5px;
                                    y: 0px;
                                    width: 10px;
                                    height: 100%;
                                    mouse-cursor: ew-resize;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            right-orig-w = crop-w;
                                            right-cursor-x = (parent.x + self.x + self.mouse-x) / preview-area.disp-w;
                                        } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                            crop-w = clamp(right-orig-w + (parent.x + self.x + self.mouse-x) / preview-area.disp-w - right-cursor-x, 0.05, 1.0 - crop-x);
                                            crop-changed();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    EditorTimeline {
                        enabled: video-loaded && !edit-busy;
                        duration: video-duration;
                        preview-time: root.preview-time;
                        frame-step: 1 / max(video-fps, 1);
                        start <=> trim-start;
                        end <=> trim-end;
                        start-text: time-start-text;
                        end-text: time-end-text;
                        preview-text: time-preview-text;
                        range-changed => { trim-changed(); }
                        seek(time) => { seek-time(time); }
                    }

                    Text { text: AppLanguage.text(crop-info-text); color: AppTheme.muted; font-size: 12px; }

                    // Marker & play buttons
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: AppLanguage.tr("Set start", "시작점 설정"); enabled: video-loaded && !edit-busy; clicked => { mark-trim-start(); } }
                        Button { text: AppLanguage.tr("Set end", "끝점 설정"); enabled: video-loaded && !edit-busy; clicked => { mark-trim-end(); } }
                        Button {
                            text: AppLanguage.tr("Limit playback", "재생 제한");
                            checkable: true;
                            checked <=> playback-limited;
                            enabled: video-loaded && !edit-busy;
                            clicked => { playback-limit-changed(); }
                        }
                        Button {
                            width: 44px;
                            height: 34px;
                            icon: @image-url("icons/rewind.svg");
                            icon-size: 22px;
                            colorize-icon: true;
                            accessible-label: playback-limited ? AppLanguage.tr("Rewind to start marker", "시작점으로 되감기") : AppLanguage.tr("Rewind to beginning", "처음으로 되감기");
                            enabled: video-loaded && !edit-busy;
                            clicked => { rewind(); }
                        }
                        Button {
                            width: 44px;
                            height: 34px;
                            primary: true;
                            icon: is-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                            icon-size: 22px;
                            colorize-icon: true;
                            accessible-label: is-playing ? AppLanguage.tr("Pause", "일시정지") : AppLanguage.tr("Play", "재생");
                            enabled: video-loaded && !edit-busy;
                            clicked => { toggle-play(); }
                        }
                        Button { text: AppLanguage.tr("Reset edits", "편집 초기화"); enabled: video-loaded && !edit-busy; clicked => { reset-edit(); } }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: AppLanguage.tr("Cut mode:", "컷 모드:"); color: AppTheme.text; vertical-alignment: center; }
                        LanguageComboBox {
                            english: ["Fast cut (stream copy)", "Exact cut (re-encode)"];
                            korean: ["빠른 컷 (스트림 복사)", "정확한 컷 (재인코딩)"];
                            current-index <=> cut-mode;
                            enabled: !edit-busy && !is-encoding;
                        }
                        Text { text: AppLanguage.tr("Set audio and subtitle options on the Encode tab", "모든 오디오/자막 옵션은 인코딩 탭에서 설정"); color: AppTheme.muted; font-size: 11px; vertical-alignment: center; }
                    }
                    Text { text: cut-mode == 0 ? AppLanguage.tr("Fast cut preserves video quality. The start may shift to a keyframe.", "빠른 컷: 영상 화질 손실 없음 · 시작점에 키프레임 오차 가능") : AppLanguage.tr("Exact cut aligns the start to a frame boundary and re-encodes to HEVC/AAC in MP4.", "정확한 컷: 선택 시작점을 프레임 경계로 맞춰 HEVC/AAC 재인코딩 · MP4 출력"); color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
                    Text { text: AppLanguage.tr("Apply edits uses the crop and trim selection. Cropping re-encodes the video.", "편집 실행: 크롭 영역과 선택 구간을 자동 적용합니다. 크롭 시 재인코딩됩니다."); color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: AppLanguage.tr("Apply edits", "편집 실행");
                            primary: true;
                            enabled: video-loaded && !edit-busy && !is-encoding && !conversion-busy && (trim-end - trim-start) > 0.05;
                            clicked => { run-edit(); }
                        }
                        Button { text: AppLanguage.tr("Cancel edit", "편집 작업 취소"); enabled: edit-busy; clicked => { cancel-edit(); } }
                    }

                    ProgressIndicator {
                        progress: edit-progress;
                        height: 8px;
                    }

                    Text {
                        text: AppLanguage.text(edit-status-text);
                        wrap: word-wrap;
                        color: AppTheme.text;
                        font-size: 12px;
                    }
                }
            }

            Tab {
                title: AppLanguage.tr("Convert", "변환");

                ConversionTab {
                    jobs: root.conversion-jobs;
                    output-folder: root.output-folder;
                    busy: root.conversion-busy;
                    other-job-running: root.is-encoding || root.edit-busy;
                    progress: root.conversion-progress;
                    status: root.conversion-status;
                    detail: root.conversion-detail;
                    format-index <=> root.conversion-format;
                    resize-width <=> root.conversion-width;
                    resize-height <=> root.conversion-height;
                    pick-files => { root.pick-conversion-files(); }
                    pick-folder => { root.pick-conversion-folder(); }
                    remove-job(index) => { root.remove-conversion-job(index); }
                    move-job(index, delta) => { root.move-conversion-job(index, delta); }
                    clear-list => { root.clear-conversion-list(); }
                    show-result(index) => { root.show-conversion-result(index); }
                    start => { root.start-conversion(false); }
                    retry => { root.start-conversion(true); }
                    cancel => { root.cancel-conversion(); }
                }
            }
        }
    }
    FileNameTooltipLayer {}
}
